{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict", "safe_to_commit", "summary", "files_to_commit", "commit_message",
    "e2e", "last_natural_stage", "first_blocker", "validations",
    "remaining_blockers", "continue_recommended"
  ],
  "properties": {
    "verdict": {"type":"string","enum":["PASS","PARTIAL_SAFE","BLOCKED","FAIL"]},
    "safe_to_commit": {"type":"boolean"},
    "summary": {"type":"string"},
    "files_to_commit": {"type":"array","items":{"type":"string"},"uniqueItems":true},
    "commit_message": {"type":"string"},
    "e2e": {"type":"string","enum":["PASS","FAIL","NOT_RUN"]},
    "last_natural_stage": {"type":"string"},
    "first_blocker": {"type":"string"},
    "validations": {
      "type":"array",
      "items": {
        "type":"object",
        "additionalProperties": false,
        "required":["name","status","evidence"],
        "properties": {
          "name":{"type":"string"},
          "status":{"type":"string","enum":["PASS","PARTIAL","FAIL","UNVERIFIED"]},
          "evidence":{"type":"string"}
        }
      }
    },
    "remaining_blockers": {"type":"array","items":{"type":"string"}},
    "continue_recommended":{"type":"boolean"}
  }
}
